                sales_channels: "Sales channels",
                channel_online_store: "Online store",
                channel_pos: "Point of sale",
                channels_help: "The collection will be available in selected channels",
                image: "Image",
                add_image: "Add image",
                drag_drop_hint: "or drag an image to upload",
