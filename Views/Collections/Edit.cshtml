                status_draft: "Draft",
                no_products: "No products in this collection",
                remove_product_confirm: "Are you sure you want to remove this product from the collection?"
            }
        };

        // Merge translations with global object
        if (typeof translations !== 'undefined') {
            if (!translations.es) translations.es = {};
            if (!translations.en) translations.en = {};
            
            Object.assign(translations.es, editCollectionTranslations.es);
            Object.assign(translations.en, editCollectionTranslations.en);
        }

        // Products Card Functions
        const collectionId = @Model.Id;
        let productOrder = [];
        
        // Initialize product order
        function initializeProductOrder() {
            productOrder = [];
            document.querySelectorAll('.product-item').forEach(item => {
                productOrder.push(parseInt(item.dataset.productId));
            });
        }
        
        // Product search functionality
        const productSearch = document.getElementById('productSearch');
        productSearch.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            document.querySelectorAll('.product-item').forEach(item => {
                const title = item.dataset.productTitle.toLowerCase();
                if (title.includes(searchTerm)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });
        
        // Product sort functionality
        const productSort = document.getElementById('productSort');
        productSort.addEventListener('change', function() {
            const sortValue = this.value;
            const productsList = document.getElementById('productsList');
            const items = Array.from(productsList.querySelectorAll('.product-item'));
            
            items.sort((a, b) => {
                switch (sortValue) {
                    case 'az':
                        return a.dataset.productTitle.localeCompare(b.dataset.productTitle);
                    case 'za':
                        return b.dataset.productTitle.localeCompare(a.dataset.productTitle);
                    case 'manual':
                    default:
                        return productOrder.indexOf(parseInt(a.dataset.productId)) - 
                               productOrder.indexOf(parseInt(b.dataset.productId));
                }
            });
            
            // Re-append sorted items
            items.forEach(item => productsList.appendChild(item));
            
            // Update order numbers
            updateOrderNumbers();
        });
        
        // Update order numbers
        function updateOrderNumbers() {
            document.querySelectorAll('.product-item').forEach((item, index) => {
                const orderNumber = item.querySelector('.order-number');
                if (orderNumber) {
                    orderNumber.textContent = index + 1;
                }
            });
        }
        
        // Remove product from collection
        function removeProductFromCollection(productId) {
            const currentLang = localStorage.getItem('preferredLanguage') || 'es';
            const confirmMessage = translations[currentLang]['remove_product_confirm'] || '¿Estás seguro de quitar este producto de la colección?';
            
            if (!confirm(confirmMessage)) {
                return;
            }
            
            fetch('@Url.Action("RemoveProductFromCollection", "Collections")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `collectionId=${collectionId}&productId=${productId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Remove the product item from DOM
                    const productItem = document.querySelector(`.product-item[data-product-id="${productId}"]`);
                    if (productItem) {
                        productItem.remove();
                    }
                    
                    // Update order numbers
                    updateOrderNumbers();
                    
                    // Update product order array
                    productOrder = productOrder.filter(id => id !== productId);
                    
                    // Check if no products left
                    if (document.querySelectorAll('.product-item').length === 0) {
                        document.getElementById('productsList').innerHTML = 
                            `<div class="no-products" data-i18n="no_products">No hay productos en esta colección</div>`;
                    }
                } else {
                    alert(data.message || 'Error al remover el producto');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al remover el producto');
            });
        }
        
        // Drag and Drop for products
        function initializeProductDragDrop() {
            let draggedElement = null;
            let draggedIndex = null;
            
            document.querySelectorAll('.product-item').forEach((item, index) => {
                item.draggable = true;
                
                item.addEventListener('dragstart', function(e) {
                    draggedElement = this;
                    draggedIndex = index;
                    this.classList.add('dragging');
                    e.dataTransfer.effectAllowed = 'move';
                });
                
                item.addEventListener('dragend', function(e) {
                    this.classList.remove('dragging');
                    document.querySelectorAll('.product-item').forEach(item => {
                        item.classList.remove('drag-over');
                    });
                });
                
                item.addEventListener('dragover', function(e) {
                    if (e.preventDefault) {
                        e.preventDefault();
                    }
                    e.dataTransfer.dropEffect = 'move';
                    
                    if (draggedElement !== this) {
                        this.classList.add('drag-over');
                    }
                    
                    return false;
                });
                
                item.addEventListener('dragleave', function(e) {
                    this.classList.remove('drag-over');
                });
                
                item.addEventListener('drop', function(e) {
                    if (e.stopPropagation) {
                        e.stopPropagation();
                    }
                    e.preventDefault();
                    
                    this.classList.remove('drag-over');
                    
                    if (draggedElement !== this) {
                        const dropIndex = Array.from(this.parentNode.children).indexOf(this);
                        
                        // Reorder DOM
                        if (draggedIndex < dropIndex) {
                            this.parentNode.insertBefore(draggedElement, this.nextSibling);
                        } else {
                            this.parentNode.insertBefore(draggedElement, this);
                        }
                        
                        // Update order numbers
                        updateOrderNumbers();
                        
                        // Update product order and save
                        updateProductOrder();
                    }
                    
                    return false;
                });
            });
        }
        
        // Update product order in database
        function updateProductOrder() {
            const newOrder = [];
            document.querySelectorAll('.product-item').forEach(item => {
                newOrder.push(parseInt(item.dataset.productId));
            });
            
            fetch('@Url.Action("UpdateProductOrder", "Collections")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `collectionId=${collectionId}&productIds=${newOrder.join(',')}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    productOrder = newOrder;
                    console.log('Product order updated successfully');
                } else {
                    console.error('Error updating product order:', data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }
        
        // Initialize on load
        document.addEventListener('DOMContentLoaded', function() {
            // Apply translations
            if (typeof translatePage === 'function') {
                const currentLang = localStorage.getItem('preferredLanguage') || 'es';
                translatePage(currentLang);
            }
            
            updateDescription();
            updateSeoPreview();
            updateCharCount('seoTitleCount', seoTitleInput.value.length, 60);
            updateCharCount('seoDescCount', seoDescInput.value.length, 160);
            validateHandle();
            
            // Initialize products functionality
            initializeProductOrder();
            initializeProductDragDrop();
            
            // Handle alert close buttons
            document.querySelectorAll('.alert .btn-close').forEach(btn => {
                btn.addEventListener('click', function() {
                    const alert = this.closest('.alert');
                    alert.style.transition = 'opacity 0.3s';
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 300);
                });
            });
            
            // Auto-dismiss success messages after 5 seconds
            const successAlert = document.querySelector('.alert-success');
            if (successAlert) {
                setTimeout(() => {
                    successAlert.style.transition = 'opacity 0.3s';
                    successAlert.style.opacity = '0';
                    setTimeout(() => successAlert.remove(), 300);
                }, 5000);
            }
        });
    </script>
}