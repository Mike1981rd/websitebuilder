                    </div>
                    <div style="padding: 20px; border-top: 1px solid #e5e5e5;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
                            <span style="font-size: 16px; font-weight: 500;">${trans['cart.subtotal'] || 'Subtotal'}</span>
                            <span style="font-size: 16px; font-weight: 500;">$${formatPrice(subtotal)}</span>
                        </div>
                        <button style="width: 100%; padding: 12px; background-color: #121212; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; margin-bottom: 8px;">
                            ${trans['cart.checkout'] || 'Checkout'}
                        </button>
                        <button onclick="if(window.closeCartDrawer) { window.closeCartDrawer('${drawerId}'); }" 
                                style="width: 100%; padding: 12px; background-color: transparent; color: #121212; border: 1px solid #121212; border-radius: 4px; cursor: pointer; font-size: 14px;">
                            ${trans['cart.continue.shopping'] || 'Continue shopping'}
                        </button>
                    </div>
                `;
            }
        }
        
        // Update cart quantity
        window.updateCartQuantity = function(productId, newQuantity) {
            console.log('[CART] Updating quantity for:', productId, 'to:', newQuantity);
            
            if (newQuantity <= 0) {
                removeFromCart(productId);
                return;
            }
            
            loadCart();
            const itemIndex = cartItems.findIndex(item => item.id === productId);
            if (itemIndex > -1) {
                cartItems[itemIndex].quantity = newQuantity;
                saveCart();
                
                // Update drawer content
                const drawers = document.querySelectorAll('.cart-drawer');
                if (drawers.length > 0) {
                    updateCartDrawerContent(drawers[0].id);
                }
                
                updateCartIconCount();
            }
        };
        
        // Update cart quantity
        window.updateCartQty = function(productId, change) {
            console.log('[CART] Updating quantity for product:', productId, 'change:', change);
            
            loadCart();
            const itemIndex = cartItems.findIndex(item => item.id === productId);
            
            if (itemIndex !== -1) {
                const item = cartItems[itemIndex];
                item.quantity += change;
                
                // Remove item if quantity reaches 0
                if (item.quantity <= 0) {
                    cartItems = cartItems.filter(i => i.id !== productId);
                    
                    // If on cart page, remove the row from DOM
                    if (window.location.pathname === '/cart') {
                        const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                        if (row) {
                            row.remove();
                        }
                    }
                } else {
                    // Update quantity display in DOM
                    const qtyElement = document.getElementById(`cart-qty-${productId}`);
                    if (qtyElement) {
                        qtyElement.textContent = item.quantity;
                    }
                    
                    // Update item total price
                    const itemTotalElements = document.querySelectorAll(`tr[data-product-id="${productId}"] .item-total`);
                    itemTotalElements.forEach(el => {
                        const total = item.price * item.quantity;
                        el.textContent = new Intl.NumberFormat(currentLanguage === 'es' ? 'es-ES' : 'en-US', {
                            style: 'currency',
                            currency: 'USD'
                        }).format(total);
                    });
                }
                
                saveCart();
                
                // Update cart subtotal
                if (window.location.pathname === '/cart') {
                    updateCartPageTotals();
                }
                
                // Update drawer content if open
                const drawers = document.querySelectorAll('.cart-drawer');
                if (drawers.length > 0) {
                    updateCartDrawerContent(drawers[0].id);
                }
                
                // Update cart icon count
                updateCartIconCount();
            }
        };
        
        // Update cart page totals
        window.updateCartPageTotals = function() {
            let subtotal = 0;
            cartItems.forEach(item => {
                subtotal += item.price * item.quantity;
            });
            
            const subtotalElement = document.getElementById('cart-subtotal');
            if (subtotalElement) {
                subtotalElement.textContent = new Intl.NumberFormat(currentLanguage === 'es' ? 'es-ES' : 'en-US', {
                    style: 'currency',
                    currency: 'USD'
                }).format(subtotal);
            }
            
            // Check if cart is empty and show empty message
            if (cartItems.length === 0) {
                const cartTable = document.querySelector('.section-wrapper[data-section-id="cart"] table');
                const emptyMessage = document.querySelector('.section-wrapper[data-section-id="cart"] .empty-cart-message');
                
                if (cartTable && !emptyMessage) {
                    // Replace table with empty cart message
                    const containerDiv = cartTable.closest('div[style*="margin: 0 auto"]');
                    if (containerDiv) {
                        containerDiv.innerHTML = `
                            <h1 style="text-align: center; margin-bottom: 40px; font-size: 36px; font-weight: 400;">
                                ${currentLanguage === 'es' ? 'Carrito' : 'Cart'}
                            </h1>
                            <div class="empty-cart-message" style="text-align: center; padding: 60px 20px;">
                                <div style="margin-bottom: 24px;">
                                    <span class="material-symbols-outlined" style="font-size: 72px; opacity: 0.3;">
                                        shopping_cart
                                    </span>
                                </div>
                                <h2 style="font-size: 24px; margin-bottom: 16px;">
                                    ${currentLanguage === 'es' ? 'Tu carrito está vacío' : 'Your cart is empty'}
                                </h2>
                                <p style="font-size: 16px; opacity: 0.7; margin-bottom: 32px;">
                                    ${currentLanguage === 'es' ? 'Agrega productos desde la página de inicio' : 'Add products from the home page'}
                                </p>
                                <button style="
                                    padding: 12px 32px;
                                    background-color: #000;
                                    color: #fff;
                                    border: none;
                                    border-radius: 4px;
                                    font-size: 16px;
                                    font-weight: 500;
                                    cursor: pointer;
                                    transition: all 0.2s ease;
                                " onclick="window.location.href='/'"
                                onmouseover="this.style.transform='scale(0.98)'"
                                onmouseout="this.style.transform='scale(1)'">
                                    ${currentLanguage === 'es' ? 'Continuar comprando' : 'Continue shopping'}
                                </button>
                            </div>
                        `;
                    }
                }
            }
        };
        
        // Remove from cart
        window.removeFromCart = function(productId) {
            console.log('[CART] Removing product:', productId);
            
            loadCart();
            cartItems = cartItems.filter(item => item.id !== productId);
            saveCart();
            
            // If on cart page, remove the row from DOM
            if (window.location.pathname === '/cart') {
                const row = document.querySelector(`tr[data-product-id="${productId}"]`);
                if (row) {
                    row.remove();
                }
                updateCartPageTotals();
            }
            
            // Update drawer content
            const drawers = document.querySelectorAll('.cart-drawer');
            if (drawers.length > 0) {
                updateCartDrawerContent(drawers[0].id);
            }
            
            updateCartIconCount();
        };
        
        // Translations
        translations = {
            'es': {
                'cart.drawer.title': 'Cajón del carrito',
                'cart.empty.message': 'Tu carrito está actualmente vacío.',
                'cart.continue.shopping': 'Continuar comprando',
                'cart.checkout': 'Finalizar compra',
                'cart.subtotal': 'Subtotal'
            },
            'en': {
                'cart.drawer.title': 'Cart drawer',
                'cart.empty.message': 'Your cart is currently empty.',
                'cart.continue.shopping': 'Continue shopping',
                'cart.checkout': 'Checkout',
                'cart.subtotal': 'Subtotal'
            }
        };
        
        $(document).ready(function() {
            loadWebsiteData();
            
            // Initialize cart count on load
            setTimeout(() => {
                updateCartIconCount();
            }, 1000);
            
            // Add to cart button event listener
            $(document).on('click', '.add-to-cart-button', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const $button = $(this);
                const productData = {
                    id: $button.data('product-id'),
                    name: $button.data('product-name'),
                    price: parseFloat($button.data('product-price')) || 0,
                    vendor: $button.data('product-vendor') || 'Store',
                    image: $button.data('product-image') || ''
                };
                
                console.log('[PREVIEW] Add to cart clicked, product data:', productData);
                
                // Use parent window's function if available
                if (window.parent && window.parent.addToCartWithData && window.parent !== window) {
                    window.parent.addToCartWithData(productData);
                } else {
                    // Handle cart in preview real
                    addToCartWithData(productData);
                }
            });
            
            // Cart icon click handler
            $(document).on('click', '.cart-icon-wrapper', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                
                console.log('[PREVIEW REAL] Cart icon clicked');
                
                // Check cart configuration for showAs option
                const cartConfig = currentSectionsConfig.cart || {};
                const showAs = cartConfig.showAs || 'drawer';
                
                console.log('[PREVIEW REAL] Cart showAs option:', showAs);
                
                // If showAs is 'page', redirect to cart page
                if (showAs === 'page') {
                    console.log('[PREVIEW REAL] Redirecting to cart page');
                    window.location.href = '/cart';
                    return false;
                }
                
                // For 'drawer' or 'drawer-and-page', open the drawer
                // Find cart drawer
                let drawers = document.querySelectorAll('.cart-drawer');
                console.log('[PREVIEW REAL] Found drawers:', drawers.length);
                
                // If no drawer exists, try to create it
                if (drawers.length === 0 && window.renderCartDrawer) {
                    console.log('[PREVIEW REAL] No drawer found, attempting to create it');
                    const drawerConfig = currentSectionsConfig.cart || { colorScheme: 'scheme1' };
                    // Ensure showAs is included in the config
                    drawerConfig.showAs = drawerConfig.showAs || 'drawer';
                    console.log('[PREVIEW REAL] Drawer config for rendering:', drawerConfig);
                    const drawerHtml = window.renderCartDrawer({ ...drawerConfig, autoOpen: false });
                    
                    if (drawerHtml) {
                        // Add drawer to body
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = drawerHtml;
                        
                        // Extract and execute scripts
                        const scripts = tempDiv.querySelectorAll('script');
                        
                        // Append all non-script elements
                        while (tempDiv.firstChild) {
                            if (tempDiv.firstChild.tagName !== 'SCRIPT') {
                                document.body.appendChild(tempDiv.firstChild);
                            } else {
                                tempDiv.removeChild(tempDiv.firstChild);
                            }
                        }
                        
                        // Execute scripts
                        scripts.forEach(script => {
                            const newScript = document.createElement('script');
                            newScript.textContent = script.textContent;
                            document.body.appendChild(newScript);
                        });
                        
                        // Re-query for drawers
                        drawers = document.querySelectorAll('.cart-drawer');
                        console.log('[PREVIEW REAL] Drawers after creation:', drawers.length);
                    }
                }
                
                // Now try to open the drawer
                if (drawers.length > 0) {
                    const drawer = drawers[0];
                    const overlay = document.getElementById(drawer.id + '-overlay');
                    console.log('[PREVIEW REAL] Found drawer:', drawer.id, 'and overlay:', overlay ? 'yes' : 'no');
                    
                    if (drawer && overlay) {
                        // Update cart content
                        updateCartDrawerContent(drawer.id);
                        
                        // Open drawer
                        console.log('[PREVIEW REAL] Opening drawer');
                        overlay.style.display = 'block';
                        setTimeout(() => {
                            drawer.style.right = '0';
                        }, 10);
                    }
                } else {
                    console.log('[PREVIEW REAL] No drawer found to open');
                }
                
                return false;
            });
        });
    </script>
</body>
</html>