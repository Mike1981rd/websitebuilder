        // Función de navegación de anuncios
        window.navigateAnnouncement = function(direction) {
            console.log('[NAVIGATE] navigateAnnouncement called with direction:', direction);
            const visibleAnnouncements = [];
            
            // Get visible announcements
            if (currentSectionsConfig && currentSectionsConfig.announcementOrder && currentSectionsConfig.announcements) {
                currentSectionsConfig.announcementOrder.forEach(id => {
                    const announcement = currentSectionsConfig.announcements[id];
                    if (announcement && !announcement.isHidden) {
                        visibleAnnouncements.push({ id, ...announcement });
                    }
                });
            }
            
            if (visibleAnnouncements.length <= 1) return;
            
            if (direction === 'prev') {
                currentAnnouncementIndex = (currentAnnouncementIndex - 1 + visibleAnnouncements.length) % visibleAnnouncements.length;
            } else {
                currentAnnouncementIndex = (currentAnnouncementIndex + 1) % visibleAnnouncements.length;
            }
            
            // Re-render preview
            renderPreviewContent();
        };
        
        // Función para iniciar autoplay de anuncios
        function startAnnouncementAutoplay() {
            stopAnnouncementAutoplay();
            
            const config = currentSectionsConfig.announcementBar;
            if (!config || config.autoplayMode === 'none') return;
            
            // Skip autoplay for marquee mode
            if (config.animationStyle === 'marquee') return;
            
            // Get visible announcements
            const visibleAnnouncements = [];
            if (currentSectionsConfig.announcementOrder && currentSectionsConfig.announcements) {
                currentSectionsConfig.announcementOrder.forEach(id => {
                    const announcement = currentSectionsConfig.announcements[id];
                    if (announcement && !announcement.isHidden) {
                        visibleAnnouncements.push({ id, ...announcement });
                    }
                });
            }
            
            // Only activate autoplay if there are multiple announcements
            if (visibleAnnouncements.length > 1) {
                const intervalMs = (config.autoplaySpeed || 6) * 1000;
                announcementAutoplayTimer = setInterval(() => {
                    window.navigateAnnouncement('next');
                }, intervalMs);
            }
        }
        
        // Función para detener autoplay
        function stopAnnouncementAutoplay() {
            if (announcementAutoplayTimer) {
                clearInterval(announcementAutoplayTimer);
                announcementAutoplayTimer = null;
            }
        }
        
        // Función para adjuntar listeners de navegación de anuncios
        function attachAnnouncementNavigationListeners() {
            console.log('[ANNOUNCEMENT NAV] Attaching navigation listeners');
            
            const prevButton = document.querySelector('.announcement-nav-prev');
            const nextButton = document.querySelector('.announcement-nav-next');
            
            if (prevButton) {
                prevButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    console.log('[ANNOUNCEMENT NAV] Prev button clicked');
                    window.navigateAnnouncement('prev');
                });
            }
            
            if (nextButton) {
                nextButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    console.log('[ANNOUNCEMENT NAV] Next button clicked');
                    window.navigateAnnouncement('next');
                });
            }
        }
        
        // Function to attach description tab event listeners
        function attachDescriptionTabListeners() {
            console.log('[DESCRIPTION TAB] Attaching description tab listeners');
            
            // Find all description tabs
            const descriptionTabs = document.querySelectorAll('.description-tab');
            
            descriptionTabs.forEach(tab => {
                // Remove any inline onclick to prevent conflicts
                tab.onclick = null;
                
                tab.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const isExpanded = this.dataset.expanded === 'true';
                    const tabId = this.id;
                    const contentId = tabId.replace('-tab', '-content');
                    const iconId = tabId.replace('-tab', '-icon');
                    
                    const content = document.getElementById(contentId);
                    const icon = document.getElementById(iconId);
                    
                    if (content && icon) {
                        if (isExpanded) {
                            // Collapse
                            content.style.display = 'none';
                            icon.textContent = 'expand_more';
                            this.dataset.expanded = 'false';
                        } else {
                            // Expand
                            content.style.display = 'block';
                            icon.textContent = 'expand_less';
                            this.dataset.expanded = 'true';
                        }
                    }
                });
            });
            
            console.log('[DESCRIPTION TAB] Attached listeners to', descriptionTabs.length, 'tabs');
        }
        
        // Función para adjuntar event listeners
        function attachPreviewEventListeners() {
            // Event listeners para el menú drawer basados en configuración
            const menuIcons = document.querySelectorAll('.header-menu-drawer .material-icons, .header-menu-drawer .material-symbols-outlined, .header-menu-drawer-icon .material-icons, .header-menu-drawer-icon .material-symbols-outlined');
            const openMenuDropdown = currentSectionsConfig.header?.openMenuDropdown || 'hover';
            
            menuIcons.forEach(menuIcon => {
                if (openMenuDropdown === 'hover') {
                    // Hover behavior para abrir drawer
                    menuIcon.addEventListener('mouseenter', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        openDrawerMenuModal();
                    });
                    
                    // Mantener drawer abierto al pasar el mouse sobre él
                    menuIcon.addEventListener('mouseleave', function(e) {
                        setTimeout(() => {
                            const drawer = document.getElementById('drawer-menu-modal');
                            const overlay = document.getElementById('drawer-menu-overlay');
                            if (drawer && !drawer.matches(':hover') && overlay && !overlay.matches(':hover')) {
                                closeDrawerMenu();
                            }
                        }, 100);
                    });
                } else {
                    // Click behavior
                    let isProcessing = false;
                    menuIcon.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        // Prevent multiple rapid clicks
                        if (isProcessing) return;
                        isProcessing = true;
                        
                        openDrawerMenuModal();
                        
                        // Reset flag after animation completes
                        setTimeout(() => {
                            isProcessing = false;
                        }, 500);
                    });
                }
            });
            
            // Event listeners para dropdowns de menú
            attachDropdownMenuListeners(document);
        }
        
