@{
    Layout = null; // Sin layout para mostrar solo el contenido
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preview - Hotel</title>
    
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Google Material Symbols (Outlined) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    
    <!-- Google Fonts - Preload common fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&family=Open+Sans:wght@400;600;700&family=Playfair+Display:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Lato:wght@400;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Reset básico */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body, html {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #ffffff;
        }
        
        /* Mobile-first responsive design */
        img {
            max-width: 100%;
            height: auto;
        }
        
        /* Slideshow specific overrides to ensure proper display */
        .slideshow-container {
            position: relative !important;
            overflow: hidden !important;
        }
        
        .slideshow-container .slide-image {
            max-width: none !important;
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }
        
        /* Container responsive */
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }
        
        /* Mobile breakpoint */
        @@media (max-width: 480px) {
            .container {
                padding: 0 10px;
            }
            
            /* Stack elements vertically on mobile */
            .flex-row {
                flex-direction: column !important;
            }
            
            /* Adjust font sizes for mobile */
            h1 { font-size: 1.5rem; }
            h2 { font-size: 1.3rem; }
            h3 { font-size: 1.1rem; }
            p { font-size: 0.9rem; }
        }
        
        /* Tablet breakpoint */
        @@media (min-width: 481px) and (max-width: 768px) {
            .container {
                padding: 0 20px;
            }
        }
        
        /* Desktop breakpoint */
        @@media (min-width: 769px) {
            .container {
                padding: 0 30px;
            }
        }
        
        /* Hide editor-only elements in preview */
        .section-header-tag {
            display: none !important;
        }
        
        /* Material Symbols styling */
        .material-symbols-outlined {
            font-variation-settings:
            'FILL' 0,
            'wght' 300,
            'GRAD' 0,
            'opsz' 20
        }
        
        /* Link transitions */
        a {
            transition: opacity 0.2s ease;
            text-decoration: none;
        }
        
        a:hover {
            opacity: 0.7;
        }
        
        /* Remove shadows from menu items */
        .menu-item-link,
        .drawer-dropdown-item a,
        .drawer-dropdown-submenu-item,
        .menu-item-parent,
        .menu-item-with-dropdown a {
            box-shadow: none !important;
            text-shadow: none !important;
        }
        
        /* High quality image rendering */
        img {
            image-rendering: auto;
            -webkit-font-smoothing: subpixel-antialiased;
            -moz-osx-font-smoothing: auto;
        }
        
        /* Slideshow specific overrides to ensure proper display */
        .slideshow-container {
            position: relative !important;
            overflow: hidden !important;
        }
        
        .slideshow-container .slide-image {
            max-width: none !important;
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }
        
        /* Header logo specific styles for HD quality */
        .header-logo-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            /* Prevent image blur on transform */
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
        
        .header-logo-wrapper img {
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
            -ms-interpolation-mode: bicubic;
            /* Force GPU acceleration for better rendering */
            will-change: transform;
            /* Prevent blur during scaling */
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            /* Ensure pixel-perfect rendering */
            shape-rendering: crispEdges;
            /* Disable font smoothing on images */
            -webkit-font-smoothing: none;
            -moz-osx-font-smoothing: auto;
        }
        
        /* Ensure no shadows on hover */
        .menu-item-link:hover,
        .drawer-dropdown-item a:hover,
        .drawer-dropdown-submenu-item:hover,
        .menu-item-parent:hover,
        .menu-item-with-dropdown a:hover {
            box-shadow: none !important;
            text-shadow: none !important;
        }
    </style>
</head>
<body>
    <div id="preview-content">
        <!-- El contenido se renderizará aquí dinámicamente -->
    </div>
    
    <!-- jQuery (necesario para el funcionamiento) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Funciones de renderizado compartidas -->
    <script src="~/js/website-render-functions.js?v=@DateTime.Now.Ticks"></script>
    
    <!-- Módulos del Website Builder -->
    <script src="~/js/website-builder/modules/multicolumn.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/image-with-text.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/testimonials.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/accordion.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/image-banner.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/newsletter.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/gallery.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/richtext.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/contact-form.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/footer.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/featured-product.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/featured-collection.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/product-container.js?v=@DateTime.Now.Ticks"></script>
    
    <script>
        // Verificar que los módulos se cargaron correctamente
        console.log('[PREVIEW] Modules loaded check:');
        console.log('- Multicolumn:', window.WebsiteBuilderModules?.Multicolumn ? 'Loaded' : 'Not loaded');
        console.log('- ProductContainer:', window.WebsiteBuilderModules?.ProductContainer ? 'Loaded' : 'Not loaded');
        console.log('- ImageWithText:', window.WebsiteBuilderModules?.ImageWithText ? 'Loaded' : 'Not loaded');
    </script>
    
    <script>
        // Variables globales necesarias para el renderizado
        window.currentSectionsConfig = {};
        window.currentGlobalThemeSettings = {};
        window.currentMenusData = [];
        let currentAnnouncementIndex = 0;
        let currentLanguage = localStorage.getItem('preferredLanguage') || 'es';
        let announcementAutoplayTimer = null;
        let translations = {};
        
        // Get page parameter from URL or ViewBag
        const urlParams = new URLSearchParams(window.location.search);
        const viewBagPage = '@ViewBag.Page';
        const viewBagProductHandle = '@ViewBag.ProductHandle';
        const currentPageId = urlParams.get('page') || (viewBagPage && viewBagPage !== '' ? viewBagPage : 'home');
        
        console.log('[PREVIEW] Debug page detection:', {
            urlParams: urlParams.toString(),
            viewBagPage: viewBagPage,
            currentPageId: currentPageId,
            url: window.location.href
        });
        
        // Alias para compatibilidad
        let currentSectionsConfig = window.currentSectionsConfig;
        let currentGlobalThemeSettings = window.currentGlobalThemeSettings;
        let currentMenusData = window.currentMenusData;
        
        // Helper function para obtener valores de color scheme
        window.getColorSchemeValues = function(schemeName) {
            // First check if we have custom values in currentGlobalThemeSettings
            if (currentGlobalThemeSettings && currentGlobalThemeSettings.colorSchemes && currentGlobalThemeSettings.colorSchemes[schemeName]) {
                return currentGlobalThemeSettings.colorSchemes[schemeName];
            }
            
            // Fall back to default color schemes
            const defaultSchemes = {
                'scheme1': {
                    background: '#ffffff',
                    text: '#333333',
                    foreground: '#f0f0f0',
                    border: '#e5e5e5',
                    link: '#2c6ecb'
                },
                'scheme2': {
                    background: '#f8f8f8',
                    text: '#1a1a1a',
                    foreground: '#eeeeee',
                    border: '#dddddd',
                    link: '#1a73e8'
                },
                'scheme3': {
                    background: '#1a1a1a',
                    text: '#ffffff',
                    foreground: '#333333',
                    border: '#444444',
                    link: '#4d9fff'
                },
                'scheme4': {
                    background: '#2c3e50',
                    text: '#ecf0f1',
                    foreground: '#34495e',
                    border: '#34495e',
                    link: '#87CEEB'
                },
                'scheme5': {
                    background: '#faf4ed',
                    text: '#5c4b3a',
                    foreground: '#f5ebe0',
                    border: '#e8d5c4',
                    link: '#8B4513'
                }
            };
            return defaultSchemes[schemeName] || defaultSchemes['scheme1'];
        };
        
        // Helper function para obtener el nombre de la fuente
        window.getFontNameFromValueSafe = function(fontValue) {
            if (!fontValue) return 'Roboto';
            const fontMap = {
                'abel': 'Abel',
                'archivo': 'Archivo',
                'archivo-narrow': 'Archivo Narrow',
                'arimo': 'Arimo',
                'assistant': 'Assistant',
                'bebas-neue': 'Bebas Neue',
                'cabin': 'Cabin',
                'chivo': 'Chivo',
                'dosis': 'Dosis',
                'fjalla-one': 'Fjalla One',
                'josefin-sans': 'Josefin Sans',
                'karla': 'Karla',
                'libre-franklin': 'Libre Franklin',
                'noto-sans': 'Noto Sans',
                'nunito-sans': 'Nunito Sans',
                'oswald': 'Oswald',
                'oxygen': 'Oxygen',
                'pt-sans': 'PT Sans',
                'raleway': 'Raleway',
                'roboto': 'Roboto',
                'rubik': 'Rubik',
                'source-sans-pro': 'Source Sans Pro',
                'titillium-web': 'Titillium Web',
                'ubuntu': 'Ubuntu',
                'work-sans': 'Work Sans',
                'arvo': 'Arvo',
                'bitter': 'Bitter',
                'cardo': 'Cardo',
                'cormorant': 'Cormorant',
                'crimson-text': 'Crimson Text',
                'david-libre': 'David Libre',
                'eb-garamond': 'EB Garamond',
                'eczar': 'Eczar',
                'inter': 'Inter',
                'lato': 'Lato',
                'libre-baskerville': 'Libre Baskerville',
                'lora': 'Lora',
                'merriweather': 'Merriweather',
                'montserrat': 'Montserrat',
                'noticia-text': 'Noticia Text',
                'noto-serif': 'Noto Serif',
                'open-sans': 'Open Sans',
                'playfair-display': 'Playfair Display',
                'poppins': 'Poppins',
                'pt-serif': 'PT Serif',
                'roboto-slab': 'Roboto Slab',
                'source-serif-pro': 'Source Serif Pro',
                'vollkorn': 'Vollkorn',
                'anonymous-pro': 'Anonymous Pro',
                'fira-mono': 'Fira Mono',
                'ibm-plex-mono': 'IBM Plex Mono',
                'inconsolata': 'Inconsolata',
                'jetbrains-mono': 'JetBrains Mono',
                'noto-sans-mono': 'Noto Sans Mono',
                'roboto-mono': 'Roboto Mono',
                'source-code-pro': 'Source Code Pro',
                'space-mono': 'Space Mono',
                'ubuntu-mono': 'Ubuntu Mono'
            };
            
            return fontMap[fontValue] || fontValue.split('-').map(word => 
                word.charAt(0).toUpperCase() + word.slice(1)
            ).join(' ');
        };
        
        // Función para cargar los datos del website
        async function loadWebsiteData() {
            try {
                // Cargar datos desde la API
                const response = await fetch('/api/builder/websites/current');
                if (!response.ok) {
                    throw new Error('Failed to load website data');
                }
                
                const websiteData = await response.json();
                console.log('[PREVIEW] Website data loaded:', websiteData);
                console.log('[PREVIEW] sectionsConfigJson:', websiteData.sectionsConfigJson);
                console.log('[PREVIEW] pagesConfigJson:', websiteData.pagesConfigJson);
                console.log('[PREVIEW] globalThemeSettingsJson:', websiteData.globalThemeSettingsJson);
                
                // Parsear las configuraciones JSON
                if (websiteData.globalThemeSettingsJson) {
                    window.currentGlobalThemeSettings = JSON.parse(websiteData.globalThemeSettingsJson);
                    currentGlobalThemeSettings = window.currentGlobalThemeSettings;
                }
                
                if (websiteData.sectionsConfigJson) {
                    try {
                        window.currentSectionsConfig = JSON.parse(websiteData.sectionsConfigJson);
                        currentSectionsConfig = window.currentSectionsConfig;
                        console.log('Sections config loaded from sectionsConfigJson:', currentSectionsConfig);
                        
                        // Normalize section names in sectionOrder
                        if (currentSectionsConfig.sectionOrder && Array.isArray(currentSectionsConfig.sectionOrder)) {
                            currentSectionsConfig.sectionOrder = currentSectionsConfig.sectionOrder.map(sectionId => {
                                // Convert hyphenated names to camelCase
                                if (sectionId === 'images-with-text') {
                                    console.log('[PREVIEW] Normalizing images-with-text to imageWithText in sectionOrder');
                                    return 'imageWithText';
                                }
                                return sectionId;
                            });
                        }
                    } catch (error) {
                        console.error('Error parsing sectionsConfigJson:', error);
                        console.log('Raw sectionsConfigJson:', websiteData.sectionsConfigJson);
                    }
                }
                
                // Load sections from pagesConfigJson
                if (websiteData.pagesConfigJson) {
                    try {
                        const pagesData = JSON.parse(websiteData.pagesConfigJson);
                        console.log('[PREVIEW] Parsed pagesConfigJson:', pagesData);
                        console.log('[PREVIEW] Loading page:', currentPageId);
                        console.log('[PREVIEW] Available pages:', Object.keys(pagesData));
                        
                        // Check if we have the requested page
                        if (pagesData[currentPageId]) {
                            // Load the specific page configuration
                            const pageConfig = pagesData[currentPageId];
                            currentSectionsConfig = {
                                ...currentSectionsConfig,
                                ...pageConfig.sectionsConfig,
                                sectionOrder: pageConfig.sectionOrder || []
                            };
                            console.log(`[PREVIEW] Sections config loaded from pagesConfigJson.${currentPageId}:`, currentSectionsConfig);
                        } else if (currentPageId === 'cart') {
                            // Special handling for cart page
                            console.log('[PREVIEW] Loading cart page configuration');
                            // Keep existing header and footer configurations
                            const existingHeader = currentSectionsConfig.header || {};
                            const existingFooter = currentSectionsConfig.footer || {};
                            const existingCart = currentSectionsConfig.cart || {};
                            
                            // Cart page should only show header, cart section, and footer
                            currentSectionsConfig = {
                                ...currentSectionsConfig,
                                sectionOrder: ['header', 'cart', 'footer'],
                                header: existingHeader,
                                footer: existingFooter,
                                cart: {
                                    ...existingCart,
                                    isHidden: false, // Force cart to be visible
                                    colorScheme: existingCart.colorScheme || 'scheme1'
                                }
                            };
                            console.log('[PREVIEW] Cart page config set:', currentSectionsConfig);
                        } else if (currentPageId === 'product') {
                            // Special handling for product page
                            console.log('[PREVIEW] Loading product page configuration');
                            console.log('[PREVIEW] ViewBag.ProductHandle:', viewBagProductHandle);
                            console.log('[PREVIEW] Current sectionsConfig before product page load:', currentSectionsConfig);
                            
                            // Keep existing header and footer configurations
                            const existingHeader = currentSectionsConfig.header || {};
                            const existingFooter = currentSectionsConfig.footer || {};
                            const existingProductContainer = currentSectionsConfig.productContainer || {};
                            
                            // Check if we have a product template page saved
                            if (pagesData['product']) {
                                console.log('[PREVIEW] Found product page in pagesData');
                                const pageConfig = pagesData['product'];
                                console.log('[PREVIEW] Product page config:', pageConfig);
                                console.log('[PREVIEW] Product page sectionsConfig:', pageConfig.sectionsConfig);
                                console.log('[PREVIEW] Product page sectionOrder:', pageConfig.sectionOrder);
                                
                                currentSectionsConfig = {
                                    ...currentSectionsConfig,
                                    ...pageConfig.sectionsConfig,
                                    sectionOrder: pageConfig.sectionOrder || []
                                };
                                
                                // Look for product container in different possible keys
                                const productContainerKey = Object.keys(currentSectionsConfig).find(key => 
                                    key.includes('product-container') || key === 'productContainer'
                                );
                                
                                console.log('[PREVIEW] Product container key found:', productContainerKey);
                                
                                // Pass the product handle to product container
                                if (productContainerKey && currentSectionsConfig[productContainerKey]) {
                                    currentSectionsConfig[productContainerKey].productHandle = viewBagProductHandle;
                                    console.log('[PREVIEW] Set product handle on config key:', productContainerKey);
                                }
                            } else {
                                console.log('[PREVIEW] No product page found, using default configuration');
                                // Product page should show header, product container, and footer
                                currentSectionsConfig = {
                                    ...currentSectionsConfig,
                                    sectionOrder: ['header', 'product-container', 'footer'],
                                    header: existingHeader,
                                    footer: existingFooter,
                                    productContainer: {
                                        ...existingProductContainer,
                                        isHidden: false,
                                        colorScheme: existingProductContainer.colorScheme || 'scheme1',
                                        productHandle: viewBagProductHandle // Pass the handle from URL
                                    }
                                };
                            }
                            console.log('[PREVIEW] Product page config set:', currentSectionsConfig);
                            console.log('[PREVIEW] Product handle:', viewBagProductHandle);
                        } else if (pagesData.home && pagesData.home.sectionsConfig) {
                            // Fallback to home page if requested page doesn't exist
                            currentSectionsConfig = {
                                ...currentSectionsConfig,
                                ...pagesData.home.sectionsConfig,
                                sectionOrder: pagesData.home.sectionOrder || []
                            };
                            console.log('[PREVIEW] Sections config loaded from pagesConfigJson.home:', currentSectionsConfig);
                        } else if (pagesData.sectionsConfig) {
                            // Single page structure: pagesData has sectionsConfig directly
                            console.log('[PREVIEW] pagesData.sectionOrder:', pagesData.sectionOrder);
                            console.log('[PREVIEW] pagesData.sectionsConfig.sectionOrder:', pagesData.sectionsConfig.sectionOrder);
                            console.log('[PREVIEW] pagesData.sectionsConfig keys:', Object.keys(pagesData.sectionsConfig));
                            
                            // Merge all properties from pagesData into currentSectionsConfig
                            currentSectionsConfig = {
                                ...currentSectionsConfig,
                                ...pagesData.sectionsConfig
                            };
                            
                            // sectionOrder can be at different levels, check both
                            if (pagesData.sectionOrder) {
                                currentSectionsConfig.sectionOrder = pagesData.sectionOrder;
                            } else if (pagesData.sectionsConfig.sectionOrder) {
                                // Already included in spread above, but make it explicit
                                currentSectionsConfig.sectionOrder = pagesData.sectionsConfig.sectionOrder;
                            }
                            
                            // Same for other arrays
                            if (pagesData.announcementOrder) {
                                currentSectionsConfig.announcementOrder = pagesData.announcementOrder;
                            } else if (pagesData.sectionsConfig.announcementOrder) {
                                currentSectionsConfig.announcementOrder = pagesData.sectionsConfig.announcementOrder;
                            }
                            
                            console.log('[PREVIEW] Sections config loaded from pagesConfigJson directly:', currentSectionsConfig);
                            console.log('[PREVIEW] currentSectionsConfig.sectionOrder after merge:', currentSectionsConfig.sectionOrder);
                        }
                    } catch (error) {
                        console.error('[PREVIEW] Error parsing pagesConfigJson:', error);
                    }
                }
                
                console.log('[PREVIEW] Final sections config:', currentSectionsConfig);
                console.log('[PREVIEW] Section order:', currentSectionsConfig?.sectionOrder);
                console.log('[PREVIEW] Slideshow config:', currentSectionsConfig?.slideshow);
                console.log('[PREVIEW] ImageWithText config:', currentSectionsConfig?.imageWithText);
                console.log('[PREVIEW] Available sections:', Object.keys(currentSectionsConfig || {}));
                
                // Si no hay sectionOrder, inicializar con valores por defecto
                if (!currentSectionsConfig.sectionOrder || currentSectionsConfig.sectionOrder.length === 0) {
                    console.log('No sections found in config, initializing default structure');
                    
                    // Inicializar estructura básica si no existe
                    if (!currentSectionsConfig.sectionOrder) {
                        currentSectionsConfig.sectionOrder = [];
                    }
                currentGlobalThemeSettings = {
                    typography: {
                        body: {
                            font: 'roboto',
                            fontSize: '14px'
                        },
                        menu: {
                            font: 'roboto',
                            fontSize: '15px'
                        }
                    },
                    colorSchemes: {
                        scheme1: {
                            background: '#ffffff',
                            text: '#333333',
                            foreground: '#f0f0f0',
                            border: '#e5e5e5'
                        }
                    }
                };
                
                currentSectionsConfig = {
                    sectionOrder: ['announcement', 'header'],
                    announcementBar: {
                        isHidden: false,
                        colorScheme: 'scheme1',
                        showOnlyHomePage: false,
                        width: 'full',
                        animationStyle: 'none',
                        text: 'Welcome to our store!'
                    },
                    announcements: {},
                    announcementOrder: [],
                    header: {
                        isHidden: false,
                        colorScheme: 'scheme1',
                        layout: 'logo-center-menu-left-inline',
                        showDivider: true,
                        desktopLogoSize: 190,
                        mobileLogoSize: 120,
                        iconStyle: 'outline',
                        cartType: 'bag',
                        navigationMenuId: 'main-menu',
                        openMenuDropdown: 'hover'
                    }
                };
                
                    // Menús de prueba
                    currentMenusData = [{
                        id: 'main-menu',
                        name: 'Main Menu',
                        items: [
                            {
                                label: 'Inicio',
                                url: '/',
                                children: []
                            },
                            {
                                label: 'Productos',
                                url: '/products',
                                children: [
                                    { label: 'Categoría 1', url: '/category1' },
                                    { label: 'Categoría 2', url: '/category2' }
                                ]
                            }
                        ]
                    }];
                }
                
                // Cargar menús si existen
                if (currentGlobalThemeSettings.menus && Array.isArray(currentGlobalThemeSettings.menus)) {
                    window.currentMenusData = currentGlobalThemeSettings.menus;
                    currentMenusData = window.currentMenusData;
                    console.log('Loaded menus from global settings:', currentMenusData);
                } else if (currentSectionsConfig.menus && Array.isArray(currentSectionsConfig.menus)) {
                    window.currentMenusData = currentSectionsConfig.menus;
                    currentMenusData = window.currentMenusData;
                    console.log('Loaded menus from sections config:', currentMenusData);
                } else {
                    console.log('No menus found, using default menu');
                }
                
                // Debug: Check which menu is configured for header
                if (currentSectionsConfig?.header?.navigationMenu) {
                    console.log('Header is configured to use menu:', currentSectionsConfig.header.navigationMenu);
                    const configuredMenu = currentMenusData.find(m => m.id === currentSectionsConfig.header.navigationMenu || m.handle === currentSectionsConfig.header.navigationMenu);
                    console.log('Found configured menu:', configuredMenu);
                }
                
                // Final check: If we're on cart page, ensure cart configuration
                if (currentPageId === 'cart') {
                    console.log('[PREVIEW] Final cart page check - ensuring cart configuration');
                    // Preserve existing configurations
                    const existingHeader = currentSectionsConfig.header || {};
                    const existingFooter = currentSectionsConfig.footer || {};
                    const existingCart = currentSectionsConfig.cart || {};
                    
                    // Override to ensure cart page shows correctly
                    currentSectionsConfig.sectionOrder = ['header', 'cart', 'footer'];
                    currentSectionsConfig.cart = {
                        ...existingCart,
                        isHidden: false
                    };
                    console.log('[PREVIEW] Final cart configuration:', currentSectionsConfig);
                }
                
                // Renderizar el contenido
                renderPreviewContent();
                
            } catch (error) {
                console.error('Error loading website data:', error);
                document.getElementById('preview-content').innerHTML = '<p style="text-align: center; padding: 50px;">Error al cargar el preview</p>';
            }
        }
        
        // Función para cargar Google Fonts dinámicamente
        function loadGoogleFont(fontValue) {
            if (!fontValue || fontValue === 'system') return;
            
            const fontName = window.getFontNameFromValueSafe(fontValue);
            const fontUrl = `https://fonts.googleapis.com/css2?family=${fontName.replace(/\s+/g, '+')}:wght@300;400;500;600;700&display=swap`;
            
            // Check if font is already loaded
            const existingLink = document.querySelector(`link[href="${fontUrl}"]`);
            if (!existingLink) {
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = fontUrl;
                document.head.appendChild(link);
                console.log('Loaded font:', fontName);
            }
        }
        
        // Function to attach accordion event listeners
        function attachAccordionEventListeners() {
            const faqHeaders = document.querySelectorAll('[data-accordion-toggle="true"]');
            console.log('[PREVIEW ACCORDION] Found', faqHeaders.length, 'FAQ headers');
            
            faqHeaders.forEach((header, index) => {
                header.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const itemIndex = this.dataset.itemIndex;
                    const accordionId = this.dataset.accordionId;
                    const content = document.querySelector(`.faq-content-${accordionId}-${itemIndex}`);
                    const isActive = this.classList.contains('active');
                    
                    // Get toggle icon element
                    const toggleIcon = this.querySelector('.faq-toggle');
                    
                    // Get accordion config to know the toggle style
                    const config = currentSectionsConfig.accordion;
                    const toggleStyle = config?.toggleStyle || 'plus-minus';
                    
                    if (isActive) {
                        this.classList.remove('active');
                        if (content) {
                            content.classList.remove('active');
                            content.style.maxHeight = '0';
                        }
                        // Update toggle icon
                        if (toggleIcon && window.WebsiteBuilderModules?.Accordion?.getToggleIcon) {
                            toggleIcon.textContent = window.WebsiteBuilderModules.Accordion.getToggleIcon(toggleStyle, false);
                        }
                    } else {
                        this.classList.add('active');
                        if (content) {
                            content.classList.add('active');
                            content.style.maxHeight = content.scrollHeight + 'px';
                        }
                        // Update toggle icon
                        if (toggleIcon && window.WebsiteBuilderModules?.Accordion?.getToggleIcon) {
                            toggleIcon.textContent = window.WebsiteBuilderModules.Accordion.getToggleIcon(toggleStyle, true);
                        }
                    }
                });
            });
        }
        
