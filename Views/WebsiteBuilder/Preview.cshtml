                if (totalItems > 0) {
                    if (cartBadge) {
                        cartBadge.textContent = totalItems;
                    } else {
                        // Get cart color scheme to apply correct colors
                        let badgeColor = '#f0f0f0';
                        let badgeTextColor = '#333333';
                        
                        // Try to get cart configuration colors
                        if (currentSectionsConfig.cart && currentSectionsConfig.cart.colorScheme) {
                            const cartScheme = currentSectionsConfig.cart.colorScheme;
                            const cartSchemeColors = getColorSchemeValues(cartScheme);
                            badgeColor = cartSchemeColors.foreground || '#f0f0f0';
                            badgeTextColor = cartSchemeColors.text || '#333333';
                            console.log('[CART] Using cart color scheme:', cartScheme);
                            console.log('[CART] Scheme colors:', cartSchemeColors);
                            console.log('[CART] Badge colors - background:', badgeColor, 'text:', badgeTextColor);
                        } else {
                            console.log('[CART] No cart color scheme found, using defaults');
