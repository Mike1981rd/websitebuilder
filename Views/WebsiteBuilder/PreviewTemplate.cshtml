@{
    Layout = null; // BUENA PRÁCTICA: Asegura que esta vista no herede ningún layout.
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preview</title>
    
    <!-- Material Icons para los iconos de las etiquetas -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Google Material Symbols (Outlined) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    
    <!-- Website Builder CSS for animations and other styles -->
    <link rel="stylesheet" href="~/css/website-builder.css" asp-append-version="true" />
    
    <!-- Mantendremos la flexibilidad para añadir CSS globales aquí si es necesario -->
    <style>
        /* Reset básico */
        body, html {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #FFFFFF; /* Fondo blanco */
        }
        
        body {
            padding-top: 0; /* Sin espacio superior */
        }
        
        /* Mobile-first responsive design */
        * {
            box-sizing: border-box;
        }
        
        img {
            max-width: 100%;
            height: auto;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
            -ms-interpolation-mode: bicubic;
            backface-visibility: hidden;
            transform: translateZ(0);
        }
        
        /* Container responsive */
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }
        
        /* Mobile breakpoint */
        @@media (max-width: 480px) {
            body {
                padding-top: 10px;
            }
            
            .container {
                padding: 0 10px;
            }
            
            /* Stack elements vertically on mobile */
            .flex-row {
                flex-direction: column !important;
            }
            
            /* Adjust font sizes for mobile */
            h1 { font-size: 1.5rem; }
            h2 { font-size: 1.3rem; }
            h3 { font-size: 1.1rem; }
            p { font-size: 0.9rem; }
        }
        
        /* Tablet breakpoint */
        @@media (min-width: 481px) and (max-width: 768px) {
            .container {
                padding: 0 20px;
            }
        }
        
        /* Desktop breakpoint */
        @@media (min-width: 769px) {
            .container {
                padding: 0 30px;
            }
        }

        /* Contenedor principal de la sección seleccionable */
        .section-wrapper {
            position: relative;
            /* El borde ahora es un box-shadow para que no afecte al layout */
            box-shadow: 0 0 0 2px transparent;
            transition: box-shadow 0.2s ease-in-out;
            margin: 0; /* Sin separación entre bloques */
        }

        .section-wrapper:hover {
            box-shadow: 0 0 0 2px #2962ff; /* Borde azul al hacer hover */
        }

        /* Etiqueta de la sección (el 'header' del bloque) */
        .section-header-tag {
            display: none !important;
            position: absolute;
            top: -14px; /* Ligeramente por encima de la sección */
            left: 10px;
            background-color: #2962ff;
            color: white;
            padding: 5px 10px;
            font-size: 13px;
            font-weight: 500;
            border-radius: 6px;
            cursor: pointer;
            z-index: 9999; /* Increased z-index to ensure labels are always on top */
            user-select: none;
            align-items: center;
            gap: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        
        /* Estilos específicos para bloques del footer */
        .footer-block-section {
            position: relative;
            overflow: visible !important;
            padding-top: 15px !important; /* Añadir espacio arriba para la pestaña */
        }
        
        .footer-block-section .section-header-tag {
            top: -10px !important; /* 35% más arriba total */
            left: 0 !important; /* Más hacia la izquierda */
            right: auto !important;
            z-index: 99999 !important;
        }
        
        /* Fix para multicolumn - subir la pestaña 30% más */
        .section-wrapper[data-section-id="multicolumn"] > .section-header-tag {
            top: -18px !important; /* 30% más arriba que la posición estándar */
            left: 10px !important;
            z-index: 999999 !important;
        }
        
        /* Hacemos visible la etiqueta con hover */
        .section-wrapper:hover > .section-header-tag {
            display: flex !important;
            opacity: 1;
            visibility: visible;
        }
        
        /* Para bloques del footer, solo mostrar etiqueta del bloque específico */
        .footer-block-section:hover > .section-header-tag {
            display: flex !important;
            opacity: 1;
            visibility: visible;
        }
        
        /* Estilos específicos para columnas de multicolumn */
        .multicolumn-column.section-wrapper {
            box-shadow: none;
            border-radius: 4px;
            overflow: visible !important; /* Ensure overflow is visible for hover labels */
        }
        
        .multicolumn-column.section-wrapper:hover {
            box-shadow: 0 0 0 2px #2962ff;
        }
        
        /* Ajustar la posición de la etiqueta para columnas */
        .multicolumn-column .section-header-tag {
            top: 5px;
            left: 5px;
            font-size: 12px;
            padding: 3px 8px;
            z-index: 9999; /* Ensure column labels are also on top */
        }
        
        /* Prevenir hover en el contenedor padre cuando se hace hover en columna */
        .multicolumn-container:hover .multicolumn-column.section-wrapper {
            box-shadow: none;
        }
        
        .multicolumn-column.section-wrapper:hover {
            box-shadow: 0 0 0 2px #2962ff !important;
        }
        
        /* Ensure parent containers don't hide overflow */
        .multicolumn-container,
        .multicolumn-row,
        .icon-columns-container {
            overflow: visible !important;
            position: relative;
        }

        /* Estilo para los nuevos iconos de Material Symbols */
        .material-symbols-outlined {
          font-variation-settings:
          'FILL' 0,
          'wght' 300,
          'GRAD' 0,
          'opsz' 20
        }
        
        /* Estilo adicional para mejorar la apariencia tipo Shopify */
        a {
            transition: opacity 0.2s ease;
        }
        
        a:hover {
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <!-- El contenido de la previsualización, como Header, Footer, etc.,
         será inyectado aquí dinámicamente por website-builder.js -->
    
    <!-- jQuery (necesario para el funcionamiento) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Variables globales necesarias para el renderizado -->
    <script>
        // Variables globales que necesitan las funciones de renderizado
        // Estas se actualizarán dinámicamente desde el parent cuando se llame renderPreview()
        let currentSectionsConfig = {};
        let currentPageData = {};
        let currentGlobalThemeSettings = {};
        let currentMenusData = [];
        let currentAnnouncementIndex = 0;
        let currentLanguage = 'es';
        let currentPageId = 'home';
        let pagesConfig = {};
        
        // Inicializar con valores del parent si están disponibles
        if (window.parent) {
            currentSectionsConfig = window.parent.currentSectionsConfig || {};
            currentGlobalThemeSettings = window.parent.currentGlobalThemeSettings || {};
            currentMenusData = window.parent.currentMenusData || [];
            currentLanguage = window.parent.currentLanguage || 'es';
            currentPageId = window.parent.currentPageId || 'home';
            pagesConfig = window.parent.pagesConfig || {};
        }
        
        // Helper function para obtener el nombre de la fuente
        window.getFontNameFromValueSafe = window.parent.getFontNameFromValueSafe || function(fontValue) {
            if (!fontValue) return 'Roboto';
            const fontMap = window.parent.globalFontMap || {
                'roboto': 'Roboto',
                'assistant': 'Assistant',
                'helvetica': 'Helvetica',
                'playfair-display': 'Playfair Display'
                // El resto del mapa se tomará del parent si está disponible
            };
            
            return fontMap[fontValue] || fontValue.split('-').map(word => 
                word.charAt(0).toUpperCase() + word.slice(1)
            ).join(' ');
        };
        
        // Navigation function for announcements
        window.navigateAnnouncement = function(direction) {
            if (window.parent && window.parent.navigateAnnouncement) {
                window.parent.navigateAnnouncement(direction);
            }
        };
    </script>
    
    <!-- Setup critical functions before loading modules -->
    <script>
        // Ensure critical functions are available before modules load
        window.WebsiteBuilderModules = window.WebsiteBuilderModules || {};
        
        // Copy getColorSchemeValues from parent if not available
        if (!window.getColorSchemeValues && window.parent && window.parent.getColorSchemeValues) {
            window.getColorSchemeValues = window.parent.getColorSchemeValues;
            console.log('[PREVIEW TEMPLATE] Copied getColorSchemeValues from parent');
        }
        
        // Copy currentGlobalThemeSettings from parent if not available
        if (!window.currentGlobalThemeSettings && window.parent && window.parent.currentGlobalThemeSettings) {
            window.currentGlobalThemeSettings = window.parent.currentGlobalThemeSettings;
            console.log('[PREVIEW TEMPLATE] Copied currentGlobalThemeSettings from parent');
        }
        
        // Ensure getColorSchemeValues is available before modules load
        if (!window.getColorSchemeValues) {
            console.warn('[PREVIEW TEMPLATE] getColorSchemeValues not available, creating basic version');
            window.getColorSchemeValues = function(schemeName) {
                const schemes = {
                    'scheme1': { background: '#ffffff', text: '#333333', border: '#e5e5e5' },
                    'scheme2': { background: '#1a1a1a', text: '#ffffff', border: '#333333' },
                    'scheme3': { background: '#f0f0f0', text: '#333333', border: '#cccccc' },
                    'scheme4': { background: '#0066cc', text: '#ffffff', border: '#0052a3' },
                    'scheme5': { background: '#ff6b6b', text: '#ffffff', border: '#ff5252' }
                };
                return schemes[schemeName] || schemes['scheme1'];
            };
        }
    </script>
    
    <!-- Funciones de renderizado compartidas -->
    <script src="~/js/website-render-functions.js?v=@DateTime.Now.Ticks"></script>
    
    <!-- Módulos del Website Builder -->
    <script src="~/js/website-builder/modules/multicolumn.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/image-with-text.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/testimonials.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/accordion.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/image-banner.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/newsletter.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/gallery.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/richtext.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/contact-form.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/footer.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/featured-product.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/featured-collection.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/website-builder/modules/product-container.js?v=@DateTime.Now.Ticks"></script>
    
    <script>
        // Log module availability after all modules are loaded
        console.log('[PREVIEW TEMPLATE] Modules loaded:', Object.keys(window.WebsiteBuilderModules || {}));
        console.log('[PREVIEW TEMPLATE] Featured Product module available:', !!window.WebsiteBuilderModules.FeaturedProduct);
        console.log('[PREVIEW TEMPLATE] Featured Collection module available:', !!window.WebsiteBuilderModules.FeaturedCollection);
        console.log('[PREVIEW TEMPLATE] getColorSchemeValues available:', typeof window.getColorSchemeValues);
        
        // Add to cart button event listener for iframe context
        $(document).ready(function() {
            $(document).on('click', '.add-to-cart-button', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const $button = $(this);
                const productData = {
                    id: $button.data('product-id'),
                    name: $button.data('product-name'),
                    price: parseFloat($button.data('product-price')) || 0,
                    vendor: $button.data('product-vendor') || 'Store',
                    image: $button.data('product-image') || ''
                };
                
                console.log('[PREVIEW] Add to cart clicked, product data:', productData);
                
                // Always use parent window's function since we're in iframe
                if (window.parent && window.parent.addToCartWithData) {
                    window.parent.addToCartWithData(productData);
                }
            });
            
            // Cart icon click handler for iframe
            $(document).on('click', '.cart-icon-wrapper', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation(); // Stop all other handlers
                
                console.log('[PREVIEW] Cart icon clicked in iframe');
                
                // Get cart configuration to check showAs setting
                let cartConfig = null;
                if (window.currentPageData && window.currentPageData.sectionsConfig && window.currentPageData.sectionsConfig.cart) {
                    cartConfig = window.currentPageData.sectionsConfig.cart;
                } else if (window.currentSectionsConfig && window.currentSectionsConfig.cart) {
                    cartConfig = window.currentSectionsConfig.cart;
                } else if (window.parent && window.parent.currentSectionsConfig && window.parent.currentSectionsConfig.cart) {
                    cartConfig = window.parent.currentSectionsConfig.cart;
                }
                
                const showAs = cartConfig?.showAs || 'drawer';
                console.log('[PREVIEW] Cart showAs setting:', showAs);
                
                // If showAs is 'page', handle differently in editor vs live site
                if (showAs === 'page') {
                    // Check if we're in the editor (parent window exists and has switchToPage function)
                    if (window.parent && window.parent !== window && window.parent.switchToPage) {
                        console.log('[PREVIEW] In editor, switching to cart page');
                        window.parent.switchToPage('cart');
                    } else {
                        console.log('[PREVIEW] In live site, redirecting to cart page');
                        window.location.href = '/cart';
                    }
                    return;
                }
                
                // Otherwise, show drawer (for 'drawer' or 'drawer-and-page')
                // First check if drawer exists
                let drawers = document.querySelectorAll('.cart-drawer');
                console.log('[PREVIEW] Found drawers:', drawers.length);
                
                // If no drawer exists, try to create it
                if (drawers.length === 0 && window.renderCartDrawer) {
                    console.log('[PREVIEW] No drawer found, attempting to create it');
                    let cartConfig = { colorScheme: 'scheme1' };
                    
                    // Try to get cart config from the correct location
                    if (window.currentPageData && window.currentPageData.sectionsConfig && window.currentPageData.sectionsConfig.cart) {
                        cartConfig = window.currentPageData.sectionsConfig.cart;
                    } else if (window.currentSectionsConfig && window.currentSectionsConfig.cart) {
                        cartConfig = window.currentSectionsConfig.cart;
                    } else if (window.parent && window.parent.currentSectionsConfig && window.parent.currentSectionsConfig.cart) {
                        cartConfig = window.parent.currentSectionsConfig.cart;
                    }
                    
                    const drawerHtml = window.renderCartDrawer({ ...cartConfig, autoOpen: false });
                    
                    if (drawerHtml) {
                        // Add drawer to body
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = drawerHtml;
                        
                        // Extract and execute scripts
                        const scripts = tempDiv.querySelectorAll('script');
                        
                        // Append all non-script elements
                        while (tempDiv.firstChild) {
                            if (tempDiv.firstChild.tagName !== 'SCRIPT') {
                                document.body.appendChild(tempDiv.firstChild);
                            } else {
                                tempDiv.removeChild(tempDiv.firstChild);
                            }
                        }
                        
                        // Execute scripts
                        scripts.forEach(script => {
                            const newScript = document.createElement('script');
                            newScript.textContent = script.textContent;
                            document.body.appendChild(newScript);
                        });
                        
                        // Re-query for drawers
                        drawers = document.querySelectorAll('.cart-drawer');
                        console.log('[PREVIEW] Drawers after creation:', drawers.length);
                    }
                }
                
                // Now try to open the drawer
                if (drawers.length > 0) {
                    const drawer = drawers[0];
                    const overlay = document.getElementById(drawer.id + '-overlay');
                    console.log('[PREVIEW] Found drawer:', drawer.id, 'and overlay:', overlay ? 'yes' : 'no');
                    
                    if (drawer && overlay) {
                        // Update cart content if parent function exists
                        if (window.parent && window.parent.updateCartDrawerContent) {
                            window.parent.updateCartDrawerContent(drawer.id);
                        }
                        
                        // Open drawer
                        console.log('[PREVIEW] Opening drawer');
                        overlay.style.display = 'block';
                        setTimeout(() => {
                            drawer.style.right = '0';
                        }, 10);
                    }
                } else {
                    console.log('[PREVIEW] No drawer found to open');
                }
                
                return false; // Extra prevention
            });
            
            // Reserve button event listener for iframe context
            $(document).on('click', '.reserve-button', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const $button = $(this);
                const productId = $button.data('product-id');
                
                console.log('[PREVIEW] Reserve button clicked, product ID:', productId);
                
                // Get product data from current product (stored in Product Container module)
                let productData = null;
                
                // Try to get product data from module
                if (window.WebsiteBuilderModules && window.WebsiteBuilderModules.ProductContainer && window.WebsiteBuilderModules.ProductContainer.currentProduct) {
                    productData = window.WebsiteBuilderModules.ProductContainer.currentProduct;
                } else {
                    // If no product data, get from button data attributes
                    productData = {
                        id: productId,
                        title: $button.data('product-title') || 'Producto',
                        price: parseFloat($button.data('product-price')) || 0
                    };
                }
                
                console.log('[PREVIEW] Product data for reservation:', productData);
                
                // Save to localStorage
                const reservationData = {
                    isReservation: true,
                    items: [{
                        ...productData,
                        quantity: 1,
                        isReservation: true
                    }]
                };
                
                localStorage.setItem('websiteBuilderCart', JSON.stringify(reservationData));
                
                // Redirect to checkout with reservation parameters
                const checkoutUrl = `/Checkout?type=reservation&productId=${productId}`;
                
                // Check if we're in iframe (preview mode) or standalone
                if (window.parent && window.parent !== window) {
                    // We're in iframe, redirect parent window
                    window.parent.location.href = checkoutUrl;
                } else {
                    // We're standalone, redirect current window
                    window.location.href = checkoutUrl;
                }
            });
        });
    </script>
</body>
</html>