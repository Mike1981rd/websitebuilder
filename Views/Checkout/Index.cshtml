                "Uruguay", "Uzbekistán", "Vanuatu", "Vaticano", "Venezuela", "Vietnam", "Yemen", "Yibuti", 
                "Zambia", "Zimbabue"
            ];
            
            // Create wrapper
            const wrapper = document.createElement('div');
            wrapper.className = 'country-select-wrapper';
            
            // Create search input
            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.className = 'country-search-input';
            searchInput.placeholder = 'Buscar país...';
            
            // Create dropdown
            const dropdown = document.createElement('div');
            dropdown.className = 'country-dropdown';
            
            // Create hidden input to store selected value
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'country';
            hiddenInput.id = 'country-hidden';
            hiddenInput.value = countrySelect.value || 'Estados Unidos';
            
            // Create display input
            const displayInput = document.createElement('input');
            displayInput.type = 'text';
            displayInput.className = 'form-input';
            displayInput.value = countrySelect.value || 'Estados Unidos';
            displayInput.readOnly = true;
            displayInput.style.cursor = 'pointer';
            
            // Populate dropdown
            function populateDropdown(filter = '') {
                dropdown.innerHTML = '';
                const filtered = countries.filter(country => 
                    country.toLowerCase().includes(filter.toLowerCase())
                );
                
                filtered.forEach(country => {
                    const option = document.createElement('div');
                    option.className = 'country-option';
                    option.textContent = country;
                    if (country === hiddenInput.value) {
                        option.classList.add('selected');
                    }
                    
                    option.addEventListener('click', function() {
                        hiddenInput.value = country;
                        displayInput.value = country;
                        dropdown.classList.remove('active');
                        searchInput.style.display = 'none';
                        displayInput.style.display = 'block';
                        searchInput.value = '';
                    });
                    
                    dropdown.appendChild(option);
                });
            }
            
            // Show dropdown on click
            displayInput.addEventListener('click', function() {
                this.style.display = 'none';
                searchInput.style.display = 'block';
                searchInput.focus();
                dropdown.classList.add('active');
                populateDropdown();
            });
            
            // Filter on search
            searchInput.addEventListener('input', function() {
                populateDropdown(this.value);
            });
            
            // Close dropdown on outside click
            document.addEventListener('click', function(e) {
                if (!wrapper.contains(e.target)) {
                    dropdown.classList.remove('active');
                    searchInput.style.display = 'none';
                    displayInput.style.display = 'block';
                    searchInput.value = '';
                }
            });
            
            // Replace original select
            countrySelect.parentNode.replaceChild(wrapper, countrySelect);
            wrapper.appendChild(hiddenInput);
            wrapper.appendChild(displayInput);
            wrapper.appendChild(searchInput);
            wrapper.appendChild(dropdown);
        }
        
        // Replace state select with text input for reservations
        function replaceStateSelectForReservations() {
            const stateSelect = document.getElementById('state-select');
            if (!stateSelect) return;
            
            // Create text input
            const stateInput = document.createElement('input');
            stateInput.type = 'text';
            stateInput.className = 'form-input';
            stateInput.id = 'state-input';
            stateInput.name = 'state';
            stateInput.placeholder = 'Estado / Provincia / Región';
            
            // Replace select with input
            stateSelect.parentNode.replaceChild(stateInput, stateSelect);
        }
        
        // Process checkout - collect all form data
        function processCheckout() {
            // Get URL parameters to check if it's a reservation
            const urlParams = new URLSearchParams(window.location.search);
            const isReservation = urlParams.get('type') === 'reservation';
            
            // Collect form data
            const formData = {
                // Contact info
                email: document.getElementById('email').value,
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                
                // Address info
                country: document.getElementById('country-hidden')?.value || document.getElementById('country-select')?.value || '',
                address: document.getElementById('address').value,
                apartment: document.getElementById('apartment').value,
                city: document.getElementById('city').value,
                state: document.getElementById('state-input')?.value || document.getElementById('state-select')?.value || '',
                postalCode: document.getElementById('postalCode').value,
                
                // Payment info (mockup - not real validation)
                cardNumber: document.getElementById('cardNumber').value,
                cardExpiry: document.getElementById('cardExpiry').value,
                cardCvv: document.getElementById('cardCvv').value,
                cardName: document.getElementById('cardName').value,
                
                // Additional flags
                newsletter: document.getElementById('newsletter').checked,
                saveInfo: document.getElementById('save-info').checked,
                billingSame: document.getElementById('billing-same').checked,
                
                // Reservation specific
                isReservation: isReservation
            };
            
            // If it's a reservation, add specific data
            if (isReservation) {
                // Get dates
                formData.checkinDate = document.getElementById('checkin-date')?.value || '';
                formData.checkoutDate = document.getElementById('checkout-date')?.value || '';
                
                // Get product info from localStorage
                // Parse cart data handling both formats
                let cartData = JSON.parse(localStorage.getItem('websiteBuilderCart') || '[]');
                let cartItems = [];
                
                if (Array.isArray(cartData)) {
                    cartItems = cartData;
                } else if (cartData && cartData.items && Array.isArray(cartData.items)) {
                    cartItems = cartData.items;
                }
                if (cartItems.length > 0 && cartItems[0].isReservation) {
                    formData.productId = cartItems[0].id;
                    formData.productName = cartItems[0].name || cartItems[0].title || 'Producto';
                    formData.pricePerNight = cartItems[0].price;
                    
                    // Calculate total if dates are selected
                    if (formData.checkinDate && formData.checkoutDate) {
                        const checkin = new Date(formData.checkinDate);
                        const checkout = new Date(formData.checkoutDate);
                        const nights = Math.floor((checkout - checkin) / (1000 * 60 * 60 * 24));
                        formData.nights = nights;
                        formData.totalAmount = formData.pricePerNight * nights;
                    }
                }
            }
            
            // Basic validation
            if (!formData.email || !formData.lastName) {
                alert('Por favor complete los campos requeridos');
                return;
            }
            
            if (isReservation && (!formData.checkinDate || !formData.checkoutDate)) {
                alert('Por favor seleccione las fechas de check-in y check-out');
                return;
            }
            
            // Show loading state
            const submitBtn = document.querySelector('.submit-btn');
            const originalBtnText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Procesando...';
            
            // Send data via AJAX
            fetch('/Checkout/ProcessPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Clear localStorage
                    localStorage.removeItem('websiteBuilderCart');
                    
                    // Show success message
                    alert(`¡Reservación confirmada! \n\nNúmero de reservación: #${result.reservationId}`);
                    
                    // Redirect to website homepage
                    setTimeout(() => {
                        window.location.href = '/WebsiteBuilder/Preview';
                    }, 2000);
                } else {
                    // Show error
                    alert('Error: ' + (result.message || 'Ocurrió un error al procesar la reservación'));
                    
                    // Re-enable button
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalBtnText;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error de conexión. Por favor intente nuevamente.');
                
                // Re-enable button
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            });
        }
    </script>
