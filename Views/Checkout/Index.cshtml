@{
    Layout = null; // No layout - standalone page like Shopify
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout - @ViewBag.StoreName</title>
    
    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #ffffff;
            color: #333;
            line-height: 1.6;
        }
        
        /* Header */
        .checkout-header {
            background-color: #fff;
            border-bottom: 1px solid #e5e5e5;
            padding: 20px 0;
        }
        
        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .logo-container img {
            height: 36px;
            width: auto;
        }
        
        .store-name {
            font-size: 20px;
            font-weight: 600;
            color: #121212;
        }
        
        .cart-summary-icon {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #666;
            cursor: pointer;
        }
        
        .cart-summary-icon:hover {
            color: #333;
        }
        
        /* Main Content */
        .checkout-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 60px;
        }
        
        @@media (max-width: 968px) {
            .checkout-main {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .order-summary {
                order: -1;
                background-color: #fafafa;
                margin: -40px -20px 40px;
                padding: 30px 20px;
            }
        }
        
        /* Express Checkout */
        .express-checkout {
            margin-bottom: 30px;
        }
        
        .express-checkout-btn {
            width: 100%;
            padding: 16px;
            background-color: #000;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: opacity 0.2s;
        }
        
        .express-checkout-btn:hover {
            opacity: 0.9;
        }
        
        .divider {
            text-align: center;
            margin: 30px 0;
            position: relative;
            color: #999;
            font-size: 14px;
        }
        
        .divider::before,
        .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 45%;
            height: 1px;
            background-color: #e5e5e5;
        }
        
        .divider::before { left: 0; }
        .divider::after { right: 0; }
        
        /* Form Sections */
        .form-section {
            margin-bottom: 40px;
        }
        
        .section-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #121212;
        }
        
        .form-group {
            margin-bottom: 16px;
        }
        
        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
            color: #333;
        }
        
        .form-input,
        .form-select {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.2s;
            background-color: #fff;
        }
        
        .form-input:focus,
        .form-select:focus {
            outline: none;
            border-color: #333;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 16px;
        }
        
        .checkbox-group input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        
        .checkbox-group label {
            font-size: 14px;
            cursor: pointer;
        }
        
        /* Order Summary */
        .order-summary {
            background-color: #fafafa;
            padding: 30px;
            border-radius: 8px;
            height: fit-content;
            position: sticky;
            top: 20px;
        }
        
        .order-item {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
            position: relative;
        }
        
        .order-item-image {
            width: 64px;
            height: 64px;
            background-color: #f0f0f0;
            border-radius: 6px;
            flex-shrink: 0;
            position: relative;
        }
        
        .order-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }
        
        .item-quantity-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #666;
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 12px;
            min-width: 20px;
            text-align: center;
        }
        
        .order-item-details {
            flex: 1;
        }
        
        .order-item-name {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 4px;
        }
        
        .order-item-price {
            font-size: 14px;
            color: #666;
        }
        
        .discount-code {
            display: flex;
            gap: 8px;
            margin: 20px 0;
        }
        
        .discount-input {
            flex: 1;
        }
        
        .apply-btn {
            padding: 12px 20px;
            background-color: #f0f0f0;
            color: #333;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        
        .apply-btn:hover {
            background-color: #e5e5e5;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }
        
        .summary-total {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e5e5e5;
            font-size: 18px;
            font-weight: 600;
        }
        
        /* Payment Section */
        .payment-methods {
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .payment-icons {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }
        
        .payment-icons img {
            height: 24px;
        }
        
        /* Submit Button */
        .submit-btn {
            width: 100%;
            padding: 16px;
            background-color: @ViewBag.SolidButtonColor;
            color: @ViewBag.SolidButtonTextColor;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
            margin-top: 20px;
        }
        
        .submit-btn:hover {
            opacity: 0.9;
        }
        
        /* Footer */
        .checkout-footer {
            max-width: 600px;
            margin: 60px auto 40px;
            padding: 0 20px;
            text-align: center;
        }
        
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .footer-links a {
            color: #0066cc;
            text-decoration: none;
            font-size: 13px;
        }
        
        .footer-links a:hover {
            text-decoration: underline;
        }
        
        .footer-copyright {
            color: #666;
            font-size: 13px;
        }
        
        /* Info Text */
        .info-text {
            font-size: 13px;
            color: #666;
            margin-top: 8px;
        }
        
        .shipping-option {
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: border-color 0.2s;
        }
        
        .shipping-option:hover {
            border-color: #999;
        }
        
        .shipping-option.selected {
            border-color: #333;
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="checkout-header">
        <div class="header-container">
            <div class="logo-container">
                @if (!string.IsNullOrEmpty(ViewBag.LogoUrl))
                {
                    <img src="@ViewBag.LogoUrl" alt="@ViewBag.StoreName" />
                }
                else
                {
                    <span class="store-name">@ViewBag.StoreName</span>
                }
            </div>
            <div class="cart-summary-icon">
                <span class="material-symbols-outlined">shopping_bag</span>
            </div>
        </div>
    </header>
    
    <!-- Main Content -->
    <main class="checkout-main">
        <!-- Left Column - Form -->
        <div class="checkout-form">
            <!-- Express Checkout -->
            <div class="express-checkout">
                <p style="font-size: 13px; color: #666; margin-bottom: 12px;">Pago exprés</p>
                <button class="express-checkout-btn">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/f/f2/Google_Pay_Logo.svg" height="20" alt="Google Pay">
                </button>
            </div>
            
            <div class="divider">O</div>
            
            <!-- Contact Section -->
            <div class="form-section">
                <h2 class="section-title">Contacto</h2>
                <div class="form-group">
                    <input type="email" class="form-input" placeholder="Email o número de teléfono móvil" required>
                </div>
                <div class="checkbox-group">
                    <input type="checkbox" id="newsletter" checked>
                    <label for="newsletter">Enviarme novedades y ofertas por correo electrónico</label>
                </div>
            </div>
            
            <!-- Delivery Section -->
            <div class="form-section">
                <h2 class="section-title">Entrega</h2>
                
                <div class="form-group">
                    <label class="form-label">País / Región</label>
                    <select class="form-select">
                        <option>Estados Unidos</option>
                        <option>México</option>
                        <option>España</option>
                        <option>Argentina</option>
                        <option>Colombia</option>
                    </select>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Nombre (opcional)">
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Apellidos">
                    </div>
                </div>
                
                <div class="form-group">
                    <input type="text" class="form-input" placeholder="Dirección">
                </div>
                
                <div class="form-group">
                    <input type="text" class="form-input" placeholder="Casa, apartamento, etc. (opcional)">
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Ciudad">
                    </div>
                    <div class="form-group">
                        <select class="form-select">
                            <option value="">Estado</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Código postal">
                    </div>
                </div>
                
                <div class="checkbox-group">
                    <input type="checkbox" id="save-info">
                    <label for="save-info">Guardar mi información y consultar más rápidamente la próxima vez</label>
                </div>
            </div>
            
            <!-- Shipping Method -->
            <div class="form-section">
                <h2 class="section-title">Métodos de envío</h2>
                <p class="info-text">Ingresa tu dirección de envío para ver los métodos disponibles.</p>
            </div>
            
            <!-- Payment Section -->
            <div class="form-section">
                <h2 class="section-title">Pago</h2>
                <p class="info-text" style="margin-bottom: 16px;">Todas las transacciones son seguras y están encriptadas.</p>
                
                <div class="payment-methods">
                    <div class="form-group">
                        <label class="form-label">Tarjeta de crédito</label>
                        <div class="payment-icons">
                            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="38" height="24" rx="4" fill="#1434CB"/>
                                <path d="M17.2969 16H15.0781L13.4141 10.0391C13.3438 9.79688 13.2344 9.66406 13.0469 9.57031C12.5859 9.32031 12.0703 9.125 11.5 9.03125V8.78125H14.7734C15.2344 8.78125 15.5859 9.13281 15.6562 9.55469L16.375 13.5078L18.0391 8.78125H20.2031L17.2969 16ZM21.3125 16H19.2266L20.9062 8.78125H23L21.3125 16ZM26.5 11.4453C26.5 10.9844 26.9219 10.7266 27.3828 10.7266C27.6797 10.7266 28.0312 10.7812 28.3281 10.8906V8.99219C28.0312 8.88281 27.6797 8.82812 27.3281 8.82812C25.5547 8.82812 24.3359 9.78906 24.3359 11.2031C24.3359 13.5078 27.125 12.6172 27.125 13.6172C27.125 14.0781 26.6484 14.3359 26.1875 14.3359C25.8359 14.3359 25.4297 14.2266 25.0781 14.0625V15.9609C25.4844 16.125 25.8906 16.1797 26.2969 16.1797C28.125 16.2344 29.2891 15.2734 29.2891 13.8594C29.2891 11.3359 26.5 12.3359 26.5 11.4453Z" fill="white"/>
                            </svg>
                            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="38" height="24" rx="4" fill="#EB001B"/>
                                <circle cx="15" cy="12" r="7" fill="#FF5F00"/>
                                <circle cx="23" cy="12" r="7" fill="#F79E1B"/>
                            </svg>
                            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="38" height="24" rx="4" fill="#0066FF"/>
                            </svg>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Número de tarjeta" maxlength="19">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <input type="text" class="form-input" placeholder="Fecha de vencimiento (MM / AA)" maxlength="7">
                        </div>
                        <div class="form-group">
                            <input type="text" class="form-input" placeholder="Código de seguridad" maxlength="4">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Nombre del titular">
                    </div>
                    
                    <div class="checkbox-group">
                        <input type="checkbox" id="billing-same">
                        <label for="billing-same">Usar la dirección de envío como dirección de facturación</label>
                    </div>
                </div>
                
                <button class="submit-btn">Pagar ahora</button>
            </div>
        </div>
        
        <!-- Right Column - Order Summary -->
        <div class="order-summary">
            <div id="order-items">
                <!-- Items will be populated by JavaScript -->
            </div>
            
            <div class="discount-code">
                <input type="text" class="form-input discount-input" placeholder="Código de descuento">
                <button class="apply-btn">Aplicar</button>
            </div>
            
            <div class="summary-row">
                <span>Subtotal</span>
                <span id="subtotal">$0.00</span>
            </div>
            
            <div class="summary-row">
                <span>Envío</span>
                <span id="shipping-cost">Introducir la dirección de envío</span>
            </div>
            
            <div class="summary-total">
                <span>Total</span>
                <span><span style="font-size: 14px; font-weight: 400;">USD</span> <span id="total">$0.00</span></span>
            </div>
        </div>
    </main>
    
    <!-- Footer -->
    <footer class="checkout-footer">
        <div class="footer-links">
            <a href="/policies/refund">Política de reembolso</a>
            <a href="/policies/shipping">Política de envío</a>
            <a href="/policies/privacy">Política de privacidad</a>
        </div>
        <div class="footer-links">
            <a href="/policies/terms">Términos del servicio</a>
        </div>
    </footer>
    
    <script>
        // Format currency with commas
        function formatCurrency(amount) {
            return new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 2
            }).format(amount);
        }
        
        // Load cart items from localStorage
        function loadCartItems() {
            const cartItems = JSON.parse(localStorage.getItem('websiteBuilderCart') || '[]');
            const orderItemsContainer = document.getElementById('order-items');
            let subtotal = 0;
            
            orderItemsContainer.innerHTML = '';
            
            cartItems.forEach(item => {
                const itemTotal = item.price * item.quantity;
                subtotal += itemTotal;
                
                const itemHtml = `
                    <div class="order-item">
                        <div class="order-item-image">
                            ${item.image ? `<img src="${item.image}" alt="${item.name}">` : `
                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                    <span class="material-symbols-outlined" style="color: #ccc;">image</span>
                                </div>
                            `}
                            <span class="item-quantity-badge">${item.quantity}</span>
                        </div>
                        <div class="order-item-details">
                            <div class="order-item-name">${item.name}</div>
                            <div class="order-item-price">${item.vendor || 'Store'}</div>
                        </div>
                        <div class="order-item-price">
                            ${formatCurrency(itemTotal)}
                        </div>
                    </div>
                `;
                
                orderItemsContainer.innerHTML += itemHtml;
            });
            
            // Update totals
            document.getElementById('subtotal').textContent = formatCurrency(subtotal);
            document.getElementById('total').textContent = formatCurrency(subtotal);
        }
        
        // Format card number input
        document.querySelector('input[placeholder="Número de tarjeta"]').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\s/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });
        
        // Format expiry date input
        document.querySelector('input[placeholder="Fecha de vencimiento (MM / AA)"]').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.slice(0, 2) + ' / ' + value.slice(2, 4);
            }
            e.target.value = value;
        });
        
        // Load cart items on page load
        loadCartItems();
    </script>
</body>
</html>